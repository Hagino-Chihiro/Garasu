init python:

    import ctypes
    import threading
    import time

    user32 = ctypes.windll.user32

    def one_popup(index):

        # 开一个弹窗线程
        def show():

            user32.MessageBoxW(
                0,
                "       ",
                "@#$($0x00%d@&^@$&*!@" % ( index * 35157 + 68585 ),
                0x50010
            )

        threading.Thread(target=show).start()

        # 等待窗口生成
        time.sleep(0.1)

        # 找窗口
        hwnd = user32.FindWindowW(
            None,
            "@#$($0x00%d@&^@$&*!@" % ( index * 35157 + 68585 )
        )

        if hwnd:
            # 移动窗口
            user32.SetWindowPos(
                hwnd,
                -1,               # HWND_TOPMOST
                100 - index * 40, # x
                100 - index * 40, # y
                300,
                150,
                0
            )


    def popup():

        for i in range(20):
            one_popup(i)

