label oder :
    m "很抱歉，我的时间到了。"

    $ x = renpy.random.randint(1,3)

    if x == 3 :
        jump send
    else :
        jump kill

label send :
    scene black
    $ renpy.pause(3.0, hard=True)
    show train_back
    e "... ..."
    e "看来你已经做出了你的选择"
    g "... ..."
    g "并没有。"
    e "... ..."
    e "是吗。"
    return

label kill :
    "*砰!*"
    return